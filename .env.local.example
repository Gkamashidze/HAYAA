# Copy this file to .env.local and fill in your values.
# On Railway these are set in the service Variables tab — DATABASE_URL is
# provided automatically when you add a PostgreSQL database.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Admin login. Username optional (defaults to "admin").
# ADMIN_PASSWORD is required by the seed — minimum 8 chars, 12+ recommended.
# Use a DIFFERENT, strong value in production (Railway service Variables).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="set-a-strong-password-here"

# WhatsApp number for orders (country code + number, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="995591000000"

# Facebook Page username for Messenger orders
NEXT_PUBLIC_MESSENGER_PAGE="hayaastore"
